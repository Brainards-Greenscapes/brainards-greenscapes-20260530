---
pagination:
  data: projectStories
  size: 1
  alias: story
  addAllPagesToCollections: true
permalink: "/projects/{{ story.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ story.title }} | Brainard's Greenscapes Las Cruces"
  description: "{{ story.summary }}"
---

<!-- Breadcrumb -->
<nav aria-label="Breadcrumb" class="bg-gray-50 py-3">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
      <li><a href="/" class="hover:text-green-700">Home</a></li>
      <li><span aria-hidden="true">&rsaquo;</span></li>
      <li><a href="/portfolio/" class="hover:text-green-700">Portfolio</a></li>
      <li><span aria-hidden="true">&rsaquo;</span></li>
      <li><a href="/projects/" class="hover:text-green-700">Projects</a></li>
      <li><span aria-hidden="true">&rsaquo;</span></li>
      <li><span class="text-gray-900">{{ story.title }}</span></li>
    </ol>
  </div>
</nav>

<!-- Hero -->
<section class="bg-green-950 text-white py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block px-3 py-1 bg-green-700/90 text-white text-xs font-medium rounded-full capitalize mb-4">{{ story.category }}</span>
    <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">{{ story.title }}</h1>
    <p class="text-green-300 text-sm mb-4">{{ story.location }}</p>
    <p class="text-green-100 text-lg">{{ story.summary }}</p>
  </div>
</section>

<!-- Timeline -->
<section class="py-16 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="relative border-l-2 border-green-200 ml-4 sm:ml-6">
      {% for step in story.steps %}
      <li class="mb-10 ml-6 sm:ml-8 last:mb-0">
        <span class="absolute flex items-center justify-center w-8 h-8 bg-green-700 text-white text-sm font-semibold rounded-full -left-4 ring-4 ring-white">{{ loop.index }}</span>
        {% if step.type == "video" %}
        <video class="rounded-xl shadow-md w-full mb-3" controls playsinline preload="metadata" poster="/assets/images/{{ step.poster }}" aria-label="{{ step.alt }}">
          <source src="/assets/images/{{ step.src }}" type="video/mp4">
        </video>
        {% else %}
        {% image "src/assets/images/" + step.src, step.alt, "rounded-xl shadow-md w-full mb-3" %}
        {% endif %}
        <p class="text-gray-700">{{ step.caption }}</p>
      </li>
      {% endfor %}
    </ol>
    {% if story.note %}
    <p class="text-sm text-gray-500 italic text-center mt-6">{{ story.note }}</p>
    {% endif %}
  </div>
</section>

<!-- More projects -->
{% if projectStories.length > 1 %}
<section class="py-16 bg-green-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-heading text-2xl md:text-3xl font-bold text-gray-900 mb-8 text-center">More Projects</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for other in projectStories %}
        {% if other.slug != story.slug %}
        <a href="/projects/{{ other.slug }}/" class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow">
          {% set heroStep = other.steps[0] %}
          {% if heroStep.type == "video" %}
          {% image "src/assets/images/" + heroStep.poster, other.title, "w-full h-48 object-cover" %}
          {% else %}
          {% image "src/assets/images/" + heroStep.src, other.title, "w-full h-48 object-cover" %}
          {% endif %}
          <div class="p-5">
            <span class="inline-block px-3 py-1 bg-green-700/90 text-white text-xs font-medium rounded-full capitalize mb-2">{{ other.category }}</span>
            <h3 class="font-heading text-lg font-semibold text-green-900 group-hover:text-green-700">{{ other.title }}</h3>
            <span class="text-green-700 text-sm font-medium">Read the full story &rarr;</span>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "partials/banner.njk" %}
